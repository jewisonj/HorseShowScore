{
  "name": "horse-show-scorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free judging and scoring tool for small horse shows. Phase 0 prototype: card screens and scoring engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "db:check": "node supabase/tests/check-migration.mjs"
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
